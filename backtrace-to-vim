#!/bin/bash

# This script starts a command and scans it stdout for a traceback. If found
# and the command terminates, the traceback is sent to the nvim-unstack plugin
# via the clipboard, which can parse the traceback and open the relevant files
# (or put it in the quickfix list, depending on how it was configured).
#
# Currently only Python tracebacks are recognized by this script, but this can
# be expanded later (nvim-unstack knows more kinds).
#
# To make this work, the vim instance must be started with remote access using
# `--listen ./vim.socket`, started in the same directory as where this script
# is started. This could maybe be made a bit more flexible in the future as well.
#
# This script is intended to work with neovim's RPC access, but could probably
# be easily modified to work with the original vim clientserver mode.
#
# This needs the nvim-unstack plugin (from
# https://github.com/relf108/nvim-unstack), version 1.5.0 or newer.

# Hardcoded for now
SOCKET=./vim-socket
TRACE=$(mktemp --tmpdir vim-traceback-XXXXXX)

# Sanity check of the TRACE variable. It would be better to properly encode the
# path when inserting in into the vim command, but that would require more
# thorough understanding of the quoting rules for both the vim expression and
# the command contained in it. Since this temp path should not contain funny
# stuff, this is easier.
if [[ ! "$TRACE" =~ ^[A-Za-z0-9/_-]+$ ]]; then
	echo "ERROR: Generated temp path ($TRACE) contains funny characters, might cause issues in vim"
	exit 1
fi

process_stderr() {
	while read -r; do
		echo "$REPLY" > /dev/stderr
		if [[ -s "$TRACE" || "$REPLY" == Traceback* ]]; then
			echo "$REPLY" >> "$TRACE"
		fi
	done
}


echo ">>> Looking for Python traceback in command output, passed to vim started with \`--listen $SOCKET\` option. <<<<"
echo

"$@" 2> >(process_stderr)

if [[ -s "$TRACE" ]]; then
	echo
	echo ">>> Found traceback, sending to vim <<<"

	# This triggers https://github.com/relf108/nvim-unstack
	# XXX: This does not do any proper escaping/encoding of $TRACE, which
	# should be ok since it is checked to only contain simple characters
	# above.
	vim --server ./vim.socket --remote-expr "execute(\":UnstackFromFile $TRACE\")"
	# Unsure if the vim command blocks until the unstack is done, so wait
	# before removing the file just to be sure.
	sleep 0.5
fi

rm "$TRACE"
